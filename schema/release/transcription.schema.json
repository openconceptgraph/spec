{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconceptgraph.org/spec/0.1/schema/release/transcription.schema.json",
  "title": "OpenConceptGraph release: the transcription layer",
  "description": "What the curriculum authority published, copied word for word with its reference. Endorsement attaches to this layer, not to anyone's reading of it.",
  "$defs": {
    "educationLevel": {
      "description": "A grade or year in the framework's own terms, beside its ISCED 2011 level.",
      "type": "object",
      "required": ["id", "type", "revision", "code", "title", "iscedLevel", "ordinal"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "type": { "const": "EducationLevel" },
        "revision": { "$ref": "../common.schema.json#/$defs/revision" },
        "code": { "description": "The local code: \"R\", \"8\", \"Y10\".", "type": "string", "minLength": 1 },
        "title": { "$ref": "../common.schema.json#/$defs/langString" },
        "iscedLevel": { "type": "integer", "minimum": 0, "maximum": 8 },
        "ordinal": { "type": "integer" }
      }
    },
    "framework": {
      "description": "One curriculum for one subject, as a base releases it: \"za-caps/mathematics\". Concepts are authored per framework. Each framework names its own structure.",
      "type": "object",
      "required": ["id", "type", "revision", "slug", "title", "jurisdiction", "subject", "nodeTypes", "educationLevels"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "type": { "const": "Framework" },
        "revision": { "$ref": "../common.schema.json#/$defs/revision" },
        "slug": { "$ref": "../common.schema.json#/$defs/slug" },
        "title": { "$ref": "../common.schema.json#/$defs/langString" },
        "jurisdiction": {
          "description": "ISO 3166-1 alpha-2 country, or ISO 3166-2 subdivision: \"ZA\", \"US-CA\".",
          "type": "string",
          "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
        },
        "subject": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "nodeTypes": {
          "description": "The framework's own vocabulary for its document structure, from the top down: [\"content-area\", \"topic\"].",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "educationLevels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/educationLevel" }
        }
      }
    },
    "check": {
      "description": "A check of a document's transcription: by machine against the source file's text layer, or by a person against the printed page.",
      "type": "object",
      "required": ["method", "date"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["machine", "person"] },
        "pages": {
          "description": "The printed pages checked. Absent means every page the release transcribes.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "date": { "$ref": "../common.schema.json#/$defs/date" },
        "by": { "description": "For a person, the public name they chose.", "type": "string", "minLength": 1 },
        "note": { "$ref": "../common.schema.json#/$defs/langString" }
      }
    },
    "document": {
      "description": "One official publication: a curriculum statement, an annual teaching plan. Citation, licence and endorsement attach here.",
      "type": "object",
      "required": ["id", "type", "revision", "framework", "title", "language"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "type": { "const": "Document" },
        "revision": { "$ref": "../common.schema.json#/$defs/revision" },
        "framework": { "$ref": "../common.schema.json#/$defs/uuid" },
        "title": { "$ref": "../common.schema.json#/$defs/officialText" },
        "language": { "$ref": "../common.schema.json#/$defs/languageTag" },
        "publisher": { "type": "string", "minLength": 1 },
        "issued": { "$ref": "../common.schema.json#/$defs/date" },
        "versionLabel": { "type": "string", "minLength": 1 },
        "url": { "$ref": "../common.schema.json#/$defs/url" },
        "rights": { "type": "string", "minLength": 1 },
        "file": {
          "description": "The published file the transcription was checked against.",
          "type": "object",
          "required": ["sha256"],
          "additionalProperties": false,
          "properties": {
            "sha256": { "$ref": "../common.schema.json#/$defs/sha256" },
            "pages": { "type": "integer", "minimum": 1 },
            "printedPageOffset": {
              "description": "File page = printed page + offset.",
              "type": "integer"
            }
          }
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
      }
    },
    "node": {
      "description": "A heading in a document's structure (content area, topic, ...), typed by the framework's vocabulary. Any depth.",
      "type": "object",
      "required": ["id", "type", "revision", "document", "parent", "nodeType", "title", "ordinal"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "type": { "const": "Node" },
        "revision": { "$ref": "../common.schema.json#/$defs/revision" },
        "document": { "$ref": "../common.schema.json#/$defs/uuid" },
        "parent": { "$ref": "../common.schema.json#/$defs/uuidOrNull" },
        "nodeType": { "type": "string", "minLength": 1 },
        "code": { "description": "The document's own numbering: \"1.3\".", "$ref": "../common.schema.json#/$defs/code" },
        "title": { "$ref": "../common.schema.json#/$defs/officialText" },
        "ordinal": { "type": "integer" }
      }
    },
    "statement": {
      "description": "Official text, word for word, with its page. The unit a concept is defined by and coverage is measured against. Its language is its document's language.",
      "type": "object",
      "required": ["id", "type", "revision", "document", "node", "parent", "statementType", "revise", "text", "ordinal"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "type": { "const": "Statement" },
        "revision": { "$ref": "../common.schema.json#/$defs/revision" },
        "document": { "$ref": "../common.schema.json#/$defs/uuid" },
        "node": { "$ref": "../common.schema.json#/$defs/uuidOrNull" },
        "parent": {
          "description": "A nested bullet points at the bullet it sits under.",
          "$ref": "../common.schema.json#/$defs/uuidOrNull"
        },
        "educationLevel": { "$ref": "../common.schema.json#/$defs/uuid" },
        "statementType": {
          "description": "content: a leaf of the content. clarification: teaching guidance beside it. progression: the authority's own account of what changes from the grade before. exemplar: a worked example. prerequisite: a stated prerequisite, such as a teaching plan's pre-knowledge cell.",
          "enum": ["content", "clarification", "progression", "exemplar", "prerequisite"]
        },
        "revise": {
          "description": "The statement points back to earlier teaching (in CAPS, it opens with \"Revise\"). It never creates a concept.",
          "type": "boolean"
        },
        "code": { "$ref": "../common.schema.json#/$defs/code" },
        "label": {
          "description": "A lead-in printed over the statement, word for word, such as \"Revise:\" or \"Example:\".",
          "$ref": "../common.schema.json#/$defs/officialText"
        },
        "heading": {
          "description": "The printed sub-heading the statement sits under within its node, word for word.",
          "$ref": "../common.schema.json#/$defs/officialText"
        },
        "text": { "$ref": "../common.schema.json#/$defs/officialText" },
        "page": { "description": "The printed page number.", "type": "integer", "minimum": 1 },
        "locator": {
          "description": "Where on the page, when the page alone is ambiguous: \"Grade 8 · Clarification notes\".",
          "type": "string",
          "minLength": 1
        },
        "ordinal": { "type": "integer" },
        "verifiedBy": {
          "description": "How the machine check confirmed the line: against the file's text layer, or, where the text layer cannot order it, by eye against the printed page.",
          "enum": ["text-layer", "eye"]
        },
        "note": {
          "description": "A transcriber's note, such as where the original's own error is kept as printed.",
          "$ref": "../common.schema.json#/$defs/langString"
        }
      }
    },
    "teachingPlan": {
      "description": "A sequence for teaching a framework: a curriculum's own terms and hours, an annual teaching plan's weeks. Timing lives here, never in a concept.",
      "type": "object",
      "required": ["id", "type", "revision", "framework", "slug", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "type": { "const": "TeachingPlan" },
        "revision": { "$ref": "../common.schema.json#/$defs/revision" },
        "framework": { "$ref": "../common.schema.json#/$defs/uuid" },
        "document": {
          "description": "The publication the plan is transcribed from.",
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "slug": { "$ref": "../common.schema.json#/$defs/slug" },
        "title": { "$ref": "../common.schema.json#/$defs/langString" }
      }
    },
    "placement": {
      "description": "When a plan teaches a node, family or concept: grade, term, weeks, hours.",
      "type": "object",
      "required": ["id", "type", "revision", "teachingPlan", "target", "targetKind", "educationLevel", "ordinal"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "type": { "const": "Placement" },
        "revision": { "$ref": "../common.schema.json#/$defs/revision" },
        "teachingPlan": { "$ref": "../common.schema.json#/$defs/uuid" },
        "target": { "$ref": "../common.schema.json#/$defs/uuid" },
        "targetKind": { "enum": ["node", "family", "concept"] },
        "educationLevel": { "$ref": "../common.schema.json#/$defs/uuid" },
        "term": { "type": "integer", "minimum": 1 },
        "weekStart": { "type": "integer", "minimum": 1 },
        "weekEnd": { "type": "integer", "minimum": 1 },
        "hours": { "type": "number", "exclusiveMinimum": 0 },
        "ordinal": { "type": "integer" },
        "asPrinted": {
          "description": "The plan's own heading for the target, word for word, where it differs from the target's.",
          "$ref": "../common.schema.json#/$defs/officialText"
        }
      }
    },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "statements": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "teachingPlans": { "type": "array", "items": { "$ref": "#/$defs/teachingPlan" } },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" } }
  }
}
